@model ToolRental.ViewModels.ReservationViewModel
@{
    ViewData["Title"] = "Ponuda alata";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <div class="row mb-4">
        <h1>Ponuda alata</h1>
    </div>

    @using (Html.BeginForm())
    {
        <p>
            Pretraga po imenu: @Html.TextBox("SearchString")
            <input type="submit" value="Search" />
        </p>
    }
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Redni broj</th>
                <th scope="col">Ime alata</th>
                <th scope="col">Opis</th>
                <th scope="col">Cijena po satu</th>
                <th scope="col">Označeno</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var toolVM in @Model.Tools)
            {
                <tr>
                    <th>@toolVM.Id</th>
                    <td>@toolVM.Name</td>
                    <td>@toolVM.Description</td>
                    <td>@toolVM.PricePerHour</td>
                    <td><input type="checkbox" value="@toolVM.Checked" /></td>
                </tr>
            }
        <tbody>
    </table>
    @* pagination *@
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)"><span aria-hidden="true">&laquo;</span></a>
                </li>
            }
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }
            @if (Model.CurrentPage + 1 > Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)"><span aria-hidden="true">&raquo;</span></a>
                </li>
            }
        </ul>
    </nav>
</div>