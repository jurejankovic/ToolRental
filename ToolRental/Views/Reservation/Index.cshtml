@model ToolRental.ViewModels.ReservationViewModel
@{
    ViewData["Title"] = "Rezervacija";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <form asp-action="SubmitToolReservation" asp-controller="Reservation" method="post" id="form-tool-reservation">

        @* 1. korak *@
        <div class="row mb-4">
            <h1>Rezervacija</h1>
        </div>
        <div class="row" id="toolSelection">
            <h3>1. Izbor alata za najam</h3>

            @Html.DropDownListFor(modelItem => modelItem.Tools, Model.ToolsSelectItems, "Izabrati alat", new { @id = "toolDropDown", @class = "select2 col-md-8", @name = "tools" })
            <div class="invalid-feedback">Izaberite alat za nastavak</div>

            <div class="col-md-8">
                <button class="btn btn-primary float-end" name="nextStep">Idući korak</button>
            </div>
        </div>

        @* 2. korak *@
        <div class="row" id="periodSelection">
            <h3>2. Parametri najma</h3>

            <div class="row mb-2">
                <div class="col-md-4">
                    <label for="duration">Ime alata</label>
                    <input class="float-end" name="toolName" value="" disabled />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <label for="duration">Opis alata</label>
                    <input class="float-end" name="toolDesc" value="" disabled />
                </div>
            </div>

            <div class="row mb-2">
                <div class="col-md-4">
                    <label for="datetimepickerStartInput" class="form-label">Datum i vrijeme početka najma</label>
                    <div class="input-group log-event"
                         id="datetimepickerStart"
                         data-td-target-input="nearest"
                         data-td-target-toggle="nearest">
                        <input id="datetimepickerStartInput"
                               type="text"
                               class="form-control"
                               data-td-target="#datetimepickerStart" />
                        <span class="input-group-text"
                              data-td-target="#datetimepickerStart"
                              data-td-toggle="datetimepicker">
                            <i class="bi bi-calendar3"></i>
                        </span>
                    </div>
                </div>

                <div class="col-md-4">
                    <label for="datetimepickerEndInput" class="form-label">Datum i vrijeme kraja najma</label>
                    <div class="input-group log-event"
                         id="datetimepickerEnd"
                         data-td-target-input="nearest"
                         data-td-target-toggle="nearest">
                        <input id="datetimepickerEndInput"
                               type="datetime"
                               class="form-control"
                               data-td-target="#datetimepickerEnd" />
                        <span class="input-group-text"
                              data-td-target="#datetimepickerEnd"
                              data-td-toggle="datetimepicker">
                            <i class="bi bi-calendar3"></i>
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-md-8 mt-5">
                <button class="btn btn-primary float-start" name="prevStep">Prethodni korak</button>
                <button class="btn btn-primary float-end" name="nextStep">Idući korak</button>
            </div>

        </div>

        @* 3. korak *@
        <div class="row" id="overview">
            <h3>3. Pregled</h3>

            <div class="row mb-2">
                <div class="col-md-4">
                    <label for="duration">Ime alata</label>
                    <input class="float-end" name="toolName" value="" disabled />
                </div>
                <div class="col-md-4">
                    <label for="duration">Opis alata</label>
                    <input class="float-end" name="toolDesc" value="" disabled />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label for="duration">Trajanje u satima</label>
                    <input class="float-end" name="duration" value="" disabled />
                </div>
                <div class="col-md-4">
                    <label for="price">Cijena najma</label>
                    <input class="float-end" name="price" value="" disabled />
                </div>
            </div>

            <div class="row mb-2">
                <div class="col-md-8 mt-5">
                    <span class="float-end">Tipkom rezerviraj potvrđujete rezervaciju alata.</span>
                </div>
            <div/>
            <div class="row mb-2">
                <div class="col-md-8 mt-5">
                    <button class="btn btn-primary float-start" name="prevStep">Prethodni korak</button>
                    <button class="btn btn-success float-end" id="finalSubmit" name="submit">Rezerviraj</button>
                    @* @Html.ActionLink("Id 2", "Index", "ToolOverview", new { id = 2 }, new { @class = "btn btn-success" }) *@
                </div>
            </div>

        </div>
    </form>
</div>

@section scripts {
    <script type="text/javascript">

        $(document).ready(function () {
            // druga dva koraka se skrivaju
            $("#periodSelection, #overview").hide();

            $("[name='nextStep'], [name='prevStep']").click(function (e) {
                e.preventDefault();

                let currentSection = $(this).closest(".row");

                if ($(this).attr("name") === "nextStep") {
                    let nextSection = currentSection.next(".row");
                    currentSection.hide();
                    nextSection.show();
                } else if ($(this).attr("name") === "prevStep") {
                    let prevSection = currentSection.prev(".row");
                    currentSection.hide();
                    prevSection.show();
                }
            });

            $('.select2').select2({
                placeholder: "Izaberite alat",
                allowClear: true,
                minimumInputLength: 3,
                ajax: {
                    url: '/Reservation/GetToolDropdownData',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            searchString: params.term,
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data, function (item) {
                                return {
                                    id: item.id,
                                    text: item.text
                                };
                            })
                        };
                    },
                    cache: true
                }
            });

            new tempusDominus.TempusDominus(document.getElementById('datetimepickerStart'), {
                localization: {
                    startOfTheWeek: 1,
                    format: 'yyyy-MM-dd HH:mm',
                    hourCycle: 'h24'
                }
            });

            new tempusDominus.TempusDominus(document.getElementById('datetimepickerEnd'), {
                localization: {
                    startOfTheWeek: 1,
                    format: 'yyyy-MM-dd HH:mm',
                    hourCycle: 'h24'
                }
            });

            $('#form-tool-reservation').on('submit', function (e) {
                const buttonClicked = $(document.activeElement);

                // submit forme se radi samo kada se klikne "Rezerviraj"
                if (buttonClicked.attr('id') !== 'finalSubmit') {
                    e.preventDefault();

                    // ako je forma validna prebaci na idući korak
                    let isValid = $('#form-tool-reservation').valid();
                    if (isValid) {
                        let currentSection = buttonClicked.closest(".row");
                        let nextSection = currentSection.next(".row");
                        currentSection.hide();
                        nextSection.show();
                    }
                }
            });
        });

    </script>
}