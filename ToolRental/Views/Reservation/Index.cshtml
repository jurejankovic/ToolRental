@model ToolRental.ViewModels.ReservationViewModel
@{
    ViewData["Title"] = "Rezervacija";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <form asp-action="SubmitToolReservation" asp-controller="Reservation" method="post" id="form-tool-reservation">

        @* 1. korak *@
        <div class="row mb-4">
            <h1>Rezervacija</h1>
        </div>
        <div class="row" id="toolSelection">
            <h3>1. Izbor alata za najam</h3>

            <div class="row mb-2">
                <div class="col-md-8">
                    @Html.DropDownListFor(modelItem => modelItem.Tools, Model.ToolsSelectItems, new { @id = "toolDropDown", @class = "select2 col-md-8", @name = "tools" })
                    <div class="invalid-feedback">Izaberite alat za nastavak</div>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-8">
                    <textarea class="col-md-8" name="toolDesc" value="" rows="3" style="resize:none" disabled></textarea>
                </div>
            </div>

            <div class="col-md-8">
                <button class="btn btn-primary float-end" name="nextStep">Idući korak</button>
            </div>
        </div>

        @* 2. korak *@
        <div class="row" id="periodSelection">
            <h3>2. Parametri najma</h3>

            <div class="row mb-2">
                <div class="col-md-4">
                    <label for="duration">Ime alata</label>
                    <input class="float-end" name="toolName" value="" disabled />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label for="duration">Opis alata</label>
                    <input class="float-end" name="toolDesc" value="" disabled />
                </div>
            </div>

            <input type="hidden" name="ChosenTool.ToolId" id="toolId" />
            <input type="hidden" name="ChosenTool.ToolName" id="toolName" />
            <input type="hidden" name="ChosenTool.ToolDesc" id="toolDesc" />
            <input type="hidden" name="Start" id="start" />
            <input type="hidden" name="End" id="end" />
            <input type="hidden" name="Duration" id="duration" />
            <input type="hidden" name="TotalPrice" id="totalPrice" />

            <label for="datetimepickerStart">Datum i vrijeme početka najma</label>
            <input type="datetime-local" id="datetimepickerStart"><br><br>

            <label for="datetimepickerEnd">Datum i vrijeme kraja najma</label>
            <input type="datetime-local" id="datetimepickerEnd"><br><br>

            <div class="col-md-8 mt-5">
                <button class="btn btn-primary float-start" name="prevStep">Prethodni korak</button>
                <button class="btn btn-primary float-end" name="nextStep">Idući korak</button>
            </div>

        </div>

        @* 3. korak *@
        <div class="row section" id="overview">
            <h3>3. Pregled</h3>

            <div class="row mb-2">
                <div class="col-md-4">
                    <label for="toolName">Ime alata</label>
                    <input class="float-end" name="toolName" value="" disabled />
                </div>
                <div class="col-md-4">
                    <label for="toolDesc">Opis alata</label>
                    <input class="float-end" name="toolDesc" value="" disabled />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label for="duration">Trajanje u satima</label>
                    <input asp-for="Duration" class="float-end" value="" disabled />
                </div>
                <div class="col-md-4">
                    <label for="price">Cijena najma</label>
                    <input asp-for="TotalPrice" class="float-end" value="" disabled />
                </div>
            </div>

            <div class="row mb-2">
                <div class="col-md-8 mt-5">
                    <span class="float-end">Tipkom rezerviraj potvrđujete rezervaciju alata.</span>
                </div>
            </div>
            <div class="col-md-8 mt-5">
                <button class="btn btn-primary float-start" name="prevStep">Prethodni korak</button>
                <button class="btn btn-success float-end" id="finalSubmit" name="submit">Rezerviraj</button>
            </div>

        </div>
    </form>
</div>

@section scripts {
    <script type="text/javascript">

        $(document).ready(function () {
            // druga dva koraka se skrivaju
            $("#periodSelection, #overview").hide();

            $("[name='nextStep'], [name='prevStep']").click(function (e) {
                e.preventDefault();

                let currentSection = $(this).closest(".row");

                if ($(this).attr("name") === "nextStep") {
                    let nextSection = currentSection.next(".row");
                    // spremaju se parametri
                    updateValues();
                    currentSection.hide();
                    nextSection.show();
                } else if ($(this).attr("name") === "prevStep") {
                    let prevSection = currentSection.prev(".row");
                    currentSection.hide();
                    prevSection.show();
                }
            });

            // parametri alata kroz wizard
            let toolId, toolName, toolDesc, dateFrom, dateTo, durationHours, pricePerHour, price;


            $('.select2').select2({
                placeholder: "Izaberite alat",
                allowClear: true,
                minimumInputLength: 3,
                ajax: {
                    url: 'api/ReservationsApi/GetToolDropdownData',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            searchString: params.term,
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data, function (item) {
                                return {
                                    id: item.value,
                                    text: item.text,
                                    desc: item.desc,
                                    pricePerHour: item.pricePerHour
                                };
                            })
                        };
                    },
                    cache: true
                }
            }).on('select2:select', function (e) {
                var selectedData = e.params.data;
                toolId = selectedData.id;
                toolName = selectedData.text;
                pricePerHour = selectedData.pricePerHour;
                $('textarea[name="toolDesc"]').val(selectedData.desc);

                $('#toolId').val(toolId);
                $('#toolName').val(toolName);
                $('#toolDesc').val(selectedData.desc);
            });;


            function updateValues() {
                toolDesc = $('textarea[name="toolDesc"]').val();

                if (toolName) $('input[name="toolName"]').val(toolName);
                if (toolDesc) $('input[name="toolDesc"]').val(toolDesc);

                $('#toolName').val(toolName);
                $('#toolDesc').val(toolDesc);

                calculateDuration();

                calculatePrice();
                
                console.log("toolName:", toolName);
                console.log("toolDesc:", toolDesc);
                console.log("dateFrom:", dateFrom);
                console.log("dateTo:", dateTo);
            }

            function calculateDuration() {
                if (dateFrom && dateTo) {
                    const momentDateFrom = moment(dateFrom);
                    const momentDateTo = moment(dateTo);

                    duration = moment.duration(momentDateTo.diff(momentDateFrom));
                    if (duration < 0) {
                        alert("Uneseni datumi nisu validni!");
                    }
                    else {
                        durationHours = Math.floor(duration.asHours());
                        $('input[name="Duration"]').val(durationHours);
                        $('#duration').val(durationHours);
                    }
                    
                }
            }

            function calculatePrice() {
                price = durationHours * pricePerHour;
                $('input[name="TotalPrice"]').val(price);
                $('#totalPrice').val(price);
            }

            $('#datetimepickerStart').on('change', (e) => {
                dateFrom = new Date(e.target.value);
                console.log("dateFrom: ", dateFrom);

                $('#start').val(dateFrom.toISOString());
            });

            $('#datetimepickerEnd').on('change', (e) => {
                dateTo = new Date(e.target.value);
                console.log("dateTo: ", dateTo);

                $('#end').val(dateTo.toISOString());
            });

            $('#form-tool-reservation').on('submit', function (e) {
                const buttonClicked = $(document.activeElement);

                // submit forme se radi samo kada se klikne "Rezerviraj"
                if (buttonClicked.attr('id') !== 'finalSubmit') {
                    e.preventDefault();

                    // ako je forma validna prebaci na idući korak
                    let isValid = $('#form-tool-reservation').valid();
                    if (isValid) {
                        let currentSection = buttonClicked.closest(".row");
                        let nextSection = currentSection.next(".row");
                        currentSection.hide();
                        nextSection.show();
                    }
                }
                else {
                    $('input[name="TotalPrice"]').val(price);
                    $('input[name="Duration"]').val(durationHours);
                }
            });
        });

    </script>
}